<!doctype html><html lang="zh-CN"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Concept Lab · AI学习研究</title>
<style>
:root{--ink:#182a32;--teal:#16635d;--line:#dce4e3;--muted:#657773}*{box-sizing:border-box}body{margin:0;background:#f3f6f3;color:var(--ink);font:15px/1.7 system-ui,'Microsoft YaHei',sans-serif}button,input,textarea,select{font:inherit}button{cursor:pointer;border:0;border-radius:9px;padding:12px 22px;background:var(--teal);color:white;font-weight:600}button:hover{filter:brightness(.92)}button:disabled{opacity:.4;cursor:default}.secondary{background:#e8efeb;color:var(--teal)}.shell{max-width:1230px;margin:auto;padding:26px 32px}.top{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid var(--line);padding-bottom:20px}.brand{font-size:20px;font-weight:750;letter-spacing:-.5px}.brand b{display:inline-flex;background:var(--teal);color:white;border-radius:9px;width:34px;height:34px;align-items:center;justify-content:center;margin-right:9px}.badge{font-size:12px;color:var(--teal);background:#e2ebe3;border-radius:30px;padding:5px 12px}h1{font-size:clamp(28px,4vw,42px);line-height:1.25;letter-spacing:-1px;margin:16px 0}h2{font-size:23px;line-height:1.4;margin:0 0 16px}h3{font-size:16px}p{margin:12px 0}.muted{color:var(--muted)}.eyebrow{font-size:12px;color:var(--teal);font-weight:700;letter-spacing:2px}.layout{display:grid;grid-template-columns:210px 1fr;gap:38px;margin-top:32px}.steps{padding:0;list-style:none}.steps li{padding:14px 12px;margin-bottom:8px;border-radius:8px;color:var(--muted);font-size:14px}.steps .active{background:#e0ebe4;color:var(--teal);font-weight:700}.stepnum{display:inline-flex;width:26px;height:26px;border:1px solid #b8c9c0;border-radius:50%;align-items:center;justify-content:center;margin-right:9px}.side{font-size:12px;color:var(--muted);border-top:1px solid var(--line);margin-top:28px;padding-top:18px}.card{background:white;border:1px solid var(--line);border-radius:16px;padding:30px;box-shadow:0 5px 30px #223c3005;margin-top:22px}.intro{padding:15px 0 0}.features{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin:26px 0}.features div{border-top:2px solid #c7d8cc;padding:14px 0}.features strong{display:block;color:var(--teal);font-size:14px}.features span{font-size:13px;color:var(--muted)}label{display:block;margin:12px 0}input[type=text],textarea,select{width:100%;border:1px solid #bfcdca;border-radius:8px;padding:12px;background:white;color:var(--ink)}textarea{min-height:110px;resize:vertical}input:focus,textarea:focus,button:focus-visible{outline:3px solid #97c5b5;outline-offset:2px}.option{border:1px solid var(--line);border-radius:9px;padding:12px 15px;cursor:pointer}.option:has(input:checked){background:#edf6f0;border-color:var(--teal)}.option input{margin-right:12px;accent-color:var(--teal)}.actions{display:flex;gap:12px;justify-content:space-between;margin-top:24px;flex-wrap:wrap}.progress{height:5px;background:#e6ede8;border-radius:5px;margin:18px 0}.progress div{height:100%;background:var(--teal);border-radius:5px}.reading{font-size:16px;line-height:1.95}.note{font-size:13px;color:var(--muted)}.message{padding:16px;margin:12px 0;border-radius:12px;white-space:pre-wrap}.user{background:#e9f2ec;margin-left:40px}.assistant{background:#f4f6f7;margin-right:30px}.message b{display:block;font-size:12px;color:var(--teal);margin-bottom:5px}.chat{max-height:360px;overflow:auto}.error{color:#a33327;white-space:pre-wrap}footer{margin-top:30px;font-size:12px;color:var(--muted)}.hide{display:none!important}@media(max-width:760px){.shell{padding:20px}.layout{grid-template-columns:1fr;gap:10px}.sidebar .steps{display:flex;flex-wrap:wrap}.steps li{padding:6px;font-size:12px}.side{display:none}.card{padding:20px}.features{gap:12px}.badge{max-width:140px;text-align:center}.user{margin-left:12px}}
@media(max-width:760px){.top{flex-wrap:wrap;gap:12px}.brand{white-space:nowrap}.top .badge{max-width:none;margin-left:auto}#language-controls{width:100%;justify-content:flex-end}.top .brand b{display:inline-flex}}
</style>
<div class="shell"><header class="top"><div class="brand"><b>C</b>Concept Lab</div><span class="badge">本机研究者技术测试</span></header><div class="layout"><aside class="sidebar"><ul class="steps" id="steps"></ul><div class="side">研究者预览<br>GLAT 中文版 · 20题<br>演示主题 · 基率与逆向概率<br><br>无学校登录<br>聊天为有限教学脚本<br>不用于正式参与者收集</div></aside><main><div id="view"></div><p class="error" id="error" role="alert"></p><footer>FYP Research Prototype · 数据仅保存在本机服务 · 不代表学校正式系统</footer></main></div></div>
<script>
let state=null,items=[],qi=0,answers=JSON.parse(sessionStorage.getItem('glat_draft_v2')||'{}');const V=document.getElementById('view');
const labels=['研究准备','AI素养测验','学习准备','概念学习','独立应用','完成与导出'];
function el(tag,text,cls){let e=document.createElement(tag);e.textContent=text;if(cls)e.className=cls;return e}
async function api(path,data){let r=await fetch('/api/'+path,{method:data?'POST':'GET',headers:data?{'Content-Type':'application/json'}:{},body:data?JSON.stringify(data):undefined});let j=await r.json();if(!r.ok)throw Error(j.error||'请求失败');return j}
function run(fn){document.getElementById('error').textContent='';Promise.resolve().then(fn).catch(e=>document.getElementById('error').textContent=e.message)}
function bind(id,fn){document.getElementById(id).onclick=()=>run(fn)}
async function update(action,data={}){state=await api(action,data);await render()}
async function render(){let stage=state?.stage||'intro',n={intro:0,quiz:1,prepare:2,learning:3,assessment:4,complete:5}[stage];document.getElementById('steps').innerHTML=labels.map((x,i)=>`<li class="${i===n?'active':''}"><span class="stepnum">${i+1}</span>${x}</li>`).join('');V.replaceChildren();
if(stage==='intro'){V.innerHTML=`<div class="intro"><span class="eyebrow">LEARN · QUESTION · UNDERSTAND</span><h1>从一个问题开始<br>探索与 AI 一起学习的过程</h1><p class="muted">先完成AI素养测验，再学习一个概念，最后独立应用。当前仅供研究者使用测试编号试用。</p></div><div class="features"><div><strong>01 固定测量</strong><span>授权GLAT中文材料</span></div><div><strong>02 过程记录</strong><span>保存消息与学习阶段</span></div><div><strong>03 独立应用</strong><span>完成后导出研究数据</span></div></div><div class="card"><h2>开始技术测试</h2><p class="note">本页不是正式知情同意书。不要输入真实学生身份。题目受材料许可约束，请勿公开转载。</p><label>测试编号<input type="text" id="pid" value="TEST-001"></label><button id="start">开始测验 →</button></div>`;bind('start',async()=>{answers={};sessionStorage.removeItem('glat_draft_v2');await update('start',{participant_id:document.getElementById('pid').value.trim(),glat_language:document.getElementById('testlang').value,ui_language:localStorage.getItem('fyp_ui')||'zh'})});return}
if(stage==='quiz'){if(!items.length)items=await api('items');qi=Math.min(qi,19);let item=items[qi];V.innerHTML=`<span class="eyebrow">AI LITERACY ASSESSMENT</span><h1>了解你的 AI 素养</h1><p class="muted">独立完成，不使用AI或外部资料。提交后不反馈答案和分数。</p><div class="card"><span class="note">第 ${qi+1} / 20 题</span><div class="progress"><div style="width:${(qi+1)*5}%"></div></div><h2 id="qtext"></h2><div id="options"></div><div class="actions"><button id="prev" class="secondary" ${qi===0?'disabled':''}>上一题</button><button id="next">${qi===19?'提交测验并继续':'下一题 →'}</button></div></div>`;document.getElementById('qtext').textContent=item.text;for(const [letter,text]of Object.entries(item.options)){let label=el('label','', 'option'),input=document.createElement('input');input.type='radio';input.name='answer';input.value=letter;input.checked=answers[item.id]===letter;input.onchange=()=>{answers[item.id]=letter;sessionStorage.setItem('glat_draft_v2',JSON.stringify(answers))};label.append(input,el('span',letter+'  '+text));document.getElementById('options').append(label)}bind('prev',()=>{qi--;render()});bind('next',async()=>{if(!answers[item.id])throw Error('请选择一个选项后继续');if(qi<19){qi++;await render()}else{await update('quiz',{answers});sessionStorage.removeItem('glat_draft_v2');items=[]}});return}
if(stage==='prepare'){V.innerHTML=`<span class="eyebrow">BEFORE LEARNING</span><h1>本次主题<br>基率与逆向概率</h1><p class="muted">这是可替换的演示主题，尚未选作正式FYP任务。</p><div class="card"><h2>先记录你的起点</h2><label>你对这个主题的熟悉程度<select id="familiarity"><option>未接触</option><option>听说过</option><option>学过但不熟悉</option><option>较熟悉</option></select></label><p>一个邮件分类器能标记90%的垃圾邮件。已知一封邮件被标记，你能否直接断定它有90%的概率是垃圾邮件？为什么？</p><textarea id="pre" placeholder="按当前理解回答即可，不反馈对错。"></textarea><div class="actions"><span class="note">这是任务专用初始判断，不是已验证量表。</span><button id="learn">进入学习 →</button></div></div>`;bind('learn',()=>update('learn',{familiarity:document.getElementById('familiarity').value,pre:document.getElementById('pre').value}));return}
if(stage==='learning'){V.innerHTML=`<span class="eyebrow">CONCEPT LEARNING</span><h1>标记正确率，等于检测率吗？</h1><div class="card reading"><h2>学习材料</h2><p>“基率”是某类情况在整体中原本所占的比例。判断一个分类结果时，除了系统检测能力，还需要考虑这类情况本身有多常见。</p><p>假设一批邮件中1%是垃圾邮件。系统会标记90%的垃圾邮件，同时也会误标记10%的正常邮件。现在随机查看一封被标记的邮件，它是垃圾邮件的概率是多少？</p><p>这里需要区分“垃圾邮件被标记的比例”与“被标记邮件中垃圾邮件的比例”。你可以借助下方助手理解这一问题。学习结束后，需要独立解释原理并应用到新情境。</p><p class="note">数据为构造的教学情境，不是实际产品性能。参考：OpenStax Introductory Statistics 2e，第3章条件概率。当前无自动倒计时，正式任务时长待预测试。</p></div><div class="card"><h2>学习对话</h2><p class="note">本机版本为有限的教学脚本，会重复固定解释；它不是实时大模型。真实开放式对话需接入XIPU AI接口或官方组件。</p><div id="chat" class="chat" aria-live="polite"></div><label>你的问题<textarea id="msg" placeholder="输入问题，可使用中文或英文。"></textarea></label><div class="actions"><button id="send">发送问题</button><button class="secondary" id="finish">结束学习，独立应用 →</button></div></div>`;for(let m of state.messages){let box=el('div','', 'message '+m.role);box.append(el('b',m.role==='user'?'你':'教学脚本'),el('div',m.text));document.getElementById('chat').append(box)}bind('send',()=>update('message',{text:document.getElementById('msg').value}));bind('finish',()=>{if(confirm('结束后不能返回学习对话。继续？'))return update('finish')});document.getElementById('chat').scrollTop=999999;return}
if(stage==='assessment'){V.innerHTML=`<span class="eyebrow">INDEPENDENT APPLICATION</span><h1>换一个情境，独立解释</h1><div class="card"><h2>内容审核任务</h2><p>某平台10000条内容中，2%确实违规。系统能标记90%的违规内容，同时会误标记5%的正常内容。一条内容被标记后，它确实违规的概率是多少？请展示推理，并说明为什么不能直接用90%作答。</p><p>如果违规内容更少，其他比例不变，你预计这个概率如何变化？说明理由。</p><textarea id="answer" placeholder="请独立回答，不使用AI。"></textarea><button id="complete">提交并完成</button><p class="note">任务专用辅助结果，不能直接当作学习增益或元认知量表得分。</p></div>`;bind('complete',()=>update('complete',{answer:document.getElementById('answer').value}));return}
V.innerHTML=`<span class="eyebrow">SESSION COMPLETE</span><h1>本次流程已完成</h1><p class="muted">GLAT答案已在后台按固定计分键处理。研究者可以下载当前测试会话，不向学习阶段反馈分数。</p><div class="card"><h2>研究者测试导出</h2><p id="summary"></p><p>JSON包含测验作答、分数、阶段和完整日志。CSV保留逐条消息，并预留人工分段与编码字段。</p><div class="actions"><button id="export">下载会话 JSON</button><button class="secondary" id="coding">下载待编码 CSV</button><button class="secondary" id="restart">新建测试会话</button></div><p class="note">CSV中的code字段为空，等待按正式编码手册分析；消息条数不等同于元认知表现。当前导出功能仅为研究者本机测试，正式系统需要独立研究者权限。</p></div>`;document.getElementById('summary').textContent=state.participant_id+' · '+state.messages.length+' 条消息';bind('export',async()=>download(await(await fetch('/api/export')).blob(),'session.json'));bind('coding',async()=>download(await(await fetch('/api/coding.csv')).blob(),'coding.csv'));bind('restart',()=>{if(confirm('先导出当前数据。新建测试？')){state=null;qi=0;items=[];render()}})
}
function download(blob,name){let url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=(state?.participant_id||'test')+'_'+name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000)}
run(async()=>{try{state=await api('state')}catch{}await render()});
</script><script src="/language.js"></script></html>
